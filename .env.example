# Copy to .env and fill in. Never commit real values.
APP_ENV=development
APP_BASE_URL=
APP_TIMEZONE=Africa/Nairobi

# AI: live uses the LLM below; mock uses canned demo answers (no key needed)
AI_MODE=live
GEMINI_API_KEY=
LLM_MODEL=gemini/gemini-3.5-flash-lite

# Leave unset to use ~/.local/share/dukaflow/media (outside the project on purpose,
# so the dev server does not restart when photos are saved)
MEDIA_STORAGE_DIR=
MAX_IMAGE_BYTES=5242880
